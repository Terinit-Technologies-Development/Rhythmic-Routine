<?xml version="1.0" encoding="utf-8"?>
<!--
  SW-2026-005 A4 TEST-ONLY probe application (AUT).
  targetContext callers use this package identity, so the exact existing
  signature permissions and exact package visibility must live here. No
  network, no QUERY_ALL_PACKAGES, no permission granting or bypass.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.terinit.rhythmicreader.permission.RECOVERY" />
    <uses-permission android:name="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />

    <queries>
        <package android:name="com.terinit.rhythmicreader" />
        <package android:name="com.terinit.rhythmicmeditation" />
        <package android:name="com.terinit.rhythmicroutine.qa" />
        <package android:name="com.terinit.rhythmicroutine" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="SW-2026-005 signer probe"
        android:testOnly="true" />
</manifest>
