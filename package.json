{
  "name": "rhythmic-routine",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.34.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:dev": "expo run:android --device",
    "android:release": "expo run:android --variant release",
    "android:prebuild": "expo prebuild --clean --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "node --stack-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "build:web": "expo export -p web",
    "test": "tsx --test src/domain/__tests__/*.test.ts src/domain/rhythm/__tests__/*.test.ts src/domain/insights/__tests__/*.test.ts",
    "postinstall": "node scripts/patch-worklets-invoker.js"
  },
  "private": true,
  "version": "1.0.0",
  "expo": {
    "install": {
      "exclude": [
        "@expo/metro-runtime",
        "expo",
        "expo-constants",
        "expo-dev-client",
        "expo-linking",
        "expo-router"
      ]
    }
  }
}
