<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.rhythmdevice">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.terinit.rhythmicreader.permission.RECOVERY" />
    <uses-permission android:name="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.terinit.rhythmicreader" />
        <package android:name="com.terinit.rhythmicmeditation" />
    </queries>

    <application>
        <service
            android:name=".RhythmEnforcementService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".RhythmOverlayActivity"
            android:theme="@style/Theme.Rhythm.Overlay"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <provider
            android:name=".RoutineAttentionPreviewProvider"
            android:authorities="${applicationId}.attention-preview"
            android:exported="true"
            android:readPermission="com.terinit.rhythmicreader.permission.RECOVERY"
            android:writePermission="com.terinit.rhythmicreader.permission.RECOVERY" />
        <provider
            android:name=".AttentionInsightProvider"
            android:authorities="${applicationId}.attention-insight"
            android:exported="true"
            android:readPermission="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS"
            android:writePermission="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />
        <provider
            android:name=".EveningSignalProvider"
            android:authorities="${applicationId}.evening-signal"
            android:exported="true"
            android:readPermission="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS"
            android:writePermission="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />
    </application>

</manifest>
